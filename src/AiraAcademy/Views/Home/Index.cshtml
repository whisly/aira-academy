@model HomeViewModel
@{
    ViewData["Title"] = "Practical AI training in Malaysia";
}

<section class="hero">
    <div class="container hero-inner">
        <p class="eyebrow">Practical AI training · Johor · KL · Penang</p>

        <h1 class="display">
            Learn AI by building<br />
            something you <em>actually</em> need.
        </h1>

        <p class="lede">
            Two-day workshops where you leave with a working system — a website, an order flow,
            a WhatsApp auto-reply — instead of a certificate and a folder of notes.
        </p>

        <div class="hero-actions">
            <a class="btn btn-primary" href="/workshops">See the workshops</a>
            <a class="btn btn-ghost" href="/contact">Talk to us first</a>
        </div>

        <dl class="stats">
            <div>
                <dt>@Model.BuilderCount<span>+</span></dt>
                <dd>builders trained</dd>
            </div>
            <div>
                <dt>@Model.WorkshopCount</dt>
                <dd>programmes</dd>
            </div>
            <div>
                <dt>@Model.CityCount</dt>
                <dd>cities, every month</dd>
            </div>
            <div>
                <dt>2<span>days</span></dt>
                <dd>from zero to shipped</dd>
            </div>
        </dl>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="section-head">
            <div>
                <p class="eyebrow eyebrow-dark">The catalogue</p>
                <h2>Find your workshop.</h2>
            </div>
            <a class="text-link" href="/workshops">All programmes <span aria-hidden="true">→</span></a>
        </div>

        <div class="grid grid-3">
            @foreach (var workshop in Model.Featured)
            {
                <partial name="_WorkshopCard" model="workshop" />
            }
        </div>
    </div>
</section>

<section class="section section-alt" id="how">
    <div class="container">
        <div class="section-head">
            <div>
                <p class="eyebrow eyebrow-dark">How it works</p>
                <h2>Three steps, no theory dumps.</h2>
            </div>
        </div>

        <ol class="steps">
            <li>
                <span class="step-no">01</span>
                <h3>Bring a real problem</h3>
                <p>
                    Not a sample dataset. Your invoices, your inbox, your customers. If it does not
                    survive contact with your own work, it is not worth building.
                </p>
            </li>
            <li>
                <span class="step-no">02</span>
                <h3>Build it with a coach beside you</h3>
                <p>
                    Small rooms, screens open, someone leaning over your shoulder when a step does
                    not behave. You type the code; we keep you out of the weeds.
                </p>
            </li>
            <li>
                <span class="step-no">03</span>
                <h3>Leave with a handover</h3>
                <p>
                    A running system, a written record of every decision, and a list of what you
                    should never let the AI do on its own.
                </p>
            </li>
        </ol>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="section-head">
            <div>
                <p class="eyebrow eyebrow-dark">From the room</p>
                <h2>What builders say afterwards.</h2>
            </div>
        </div>

        <div class="grid grid-3">
            @foreach (var quote in Model.Testimonials)
            {
                <figure class="quote-card">
                    <blockquote>“@quote.Quote”</blockquote>
                    <figcaption>
                        <span class="avatar" aria-hidden="true">@quote.Initials</span>
                        <span>
                            <strong>@quote.Name</strong>
                            <small>@quote.Role</small>
                        </span>
                    </figcaption>
                </figure>
            }
        </div>
    </div>
</section>

<section class="section section-dark">
    <div class="container locations">
        <div>
            <p class="eyebrow">Where we teach</p>
            <h2>Three cities, every month.</h2>
            <p class="lede-sm">
                Rooms are small on purpose — 6 to 16 people. Corporate programmes run on site
                anywhere in Peninsular Malaysia.
            </p>
        </div>

        <ul class="city-list">
            <li>
                <strong>Johor</strong>
                <span>Iskandar Puteri · weekend runs</span>
            </li>
            <li>
                <strong>Kuala Lumpur</strong>
                <span>Sentul · weekday runs</span>
            </li>
            <li>
                <strong>Penang</strong>
                <span>George Town · monthly runs</span>
            </li>
        </ul>
    </div>
</section>

<section class="section">
    <div class="container cta-band">
        <div>
            <h2>Not sure which one fits?</h2>
            <p>Tell us what is slowing your team down. We will tell you honestly whether a workshop helps.</p>
        </div>
        <a class="btn btn-primary" href="/contact">Start a conversation</a>
    </div>
</section>
