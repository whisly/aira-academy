@{
    var path = Context.Request.Path.Value ?? "/";
    string Nav(string href) => path.StartsWith(href, StringComparison.OrdinalIgnoreCase) ? "nav-link is-active" : "nav-link";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Aira Academy</title>
    <meta name="description" content="@(ViewData["Description"] ?? "Practical AI training for Malaysian businesses. Two-day workshops where you leave with a working system, not a certificate.")" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/js/site.js" asp-append-version="true" defer></script>
</head>
<body>
    <header class="site-header">
        <div class="container header-inner">
            <a class="brand" href="/" aria-label="Aira Academy home">
                <span class="brand-mark" aria-hidden="true">A</span>
                <span class="brand-text">
                    <strong>Aira Academy</strong>
                    <small>Practical AI training</small>
                </span>
            </a>

            <div class="header-actions">
                <nav class="site-nav only-desktop" aria-label="Primary">
                    <a class="@Nav("/workshops")" href="/workshops">Workshops</a>
                    <a class="@Nav("/about")" href="/#how">How it works</a>
                    <a class="@Nav("/contact")" href="/contact">Contact</a>
                    <a class="btn btn-primary btn-sm" href="/contact">Book a seat</a>
                </nav>

                <button class="icon-btn" type="button"
                        data-drawer-open="lang"
                        aria-controls="lang-drawer"
                        aria-expanded="false"
                        aria-haspopup="dialog">
                    <i class="ico-lang" data-lang-current>EN</i>
                    <span class="sr-only">Change language</span>
                </button>

                <button class="icon-btn only-mobile" type="button"
                        data-drawer-open="menu"
                        aria-controls="menu-drawer"
                        aria-expanded="false"
                        aria-haspopup="dialog">
                    <i class="ico-menu" aria-hidden="true"></i>
                    <span class="sr-only">Open menu</span>
                </button>
            </div>
        </div>
    </header>

    <main id="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-inner">
            <div class="footer-brand">
                <span class="brand-mark" aria-hidden="true">A</span>
                <div>
                    <strong>Aira Academy</strong>
                    <p>Learn AI by building something real.<br />Johor · Kuala Lumpur · Penang</p>
                </div>
            </div>

            <div class="footer-col">
                <h4>Workshops</h4>
                <a href="/workshops/one-person-company">One Person Company</a>
                <a href="/workshops/people-ops">People Operations</a>
                <a href="/workshops/finance-operations">Finance Operations</a>
                <a href="/workshops/corporate-team">Corporate Programme</a>
            </div>

            <div class="footer-col">
                <h4>Company</h4>
                <a href="/#how">How it works</a>
                <a href="/contact">Contact</a>
                <a href="/contact">Request a proposal</a>
            </div>

            <div class="footer-col">
                <h4>Contact</h4>
                <a href="mailto:hello@aira.academy">hello@aira.academy</a>
                <span>+60 12-000 0000</span>
                <span>Mon–Fri, 9am–6pm</span>
            </div>
        </div>

        <div class="container footer-bottom">
            <span>© @DateTime.UtcNow.Year Aira Academy Sdn Bhd</span>
            <span>Sample site · built as a .NET portfolio piece</span>
        </div>
    </footer>

    <!-- ------------------------------------------------ navigation drawer (mobile) -->
    <div class="drawer" id="menu-drawer" data-drawer="menu" aria-hidden="true">
        <div class="drawer-backdrop" data-drawer-close></div>
        <aside class="drawer-panel" role="dialog" aria-modal="true" aria-labelledby="menu-drawer-title">
            <div class="drawer-head">
                <span class="drawer-title" id="menu-drawer-title">Menu</span>
                <button class="icon-btn" type="button" data-drawer-close data-drawer-autofocus>
                    <i class="ico-close" aria-hidden="true"></i>
                    <span class="sr-only">Close menu</span>
                </button>
            </div>

            <nav class="drawer-nav" aria-label="Primary mobile">
                <a href="/workshops">Workshops</a>
                <a href="/#how">How it works</a>
                <a href="/contact">Contact</a>
            </nav>

            <a class="btn btn-primary btn-block" href="/contact">Book a seat</a>

            <p class="drawer-foot">
                Johor · Kuala Lumpur · Penang<br />
                <a href="mailto:hello@aira.academy">hello@aira.academy</a>
            </p>
        </aside>
    </div>

    <!-- ------------------------------------------------ language drawer -->
    <div class="drawer" id="lang-drawer" data-drawer="lang" aria-hidden="true">
        <div class="drawer-backdrop" data-drawer-close></div>
        <aside class="drawer-panel" role="dialog" aria-modal="true" aria-labelledby="lang-drawer-title">
            <div class="drawer-head">
                <span class="drawer-title" id="lang-drawer-title">Language</span>
                <button class="icon-btn" type="button" data-drawer-close data-drawer-autofocus>
                    <i class="ico-close" aria-hidden="true"></i>
                    <span class="sr-only">Close language picker</span>
                </button>
            </div>

            <div class="lang-list">
                <button class="lang-option" type="button" data-lang-option="en" aria-pressed="false">
                    <span>English</span>
                    <small>EN</small>
                </button>
                <button class="lang-option" type="button" data-lang-option="zh" aria-pressed="false">
                    <span>中文</span>
                    <small>CN</small>
                </button>
                <button class="lang-option" type="button" data-lang-option="ms" aria-pressed="false">
                    <span>Bahasa Melayu</span>
                    <small>BM</small>
                </button>
            </div>

            <p class="drawer-foot">
                Your choice is remembered on this device. Page copy is still English while
                the translated content is being written.
            </p>
        </aside>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
